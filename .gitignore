# 运行数据不属于源码：索引、片段缓存、模型权重和原始文档都由使用方自己准备。

# 索引与缓存，由 python main.py build 生成
data/chunks.pkl
data/build_manifest.json
data/build_manifest.pending
# 不带斜杠：Milvus Lite 新旧布局分别是文件与目录，两种都不进库。
data/milvus.db

# chunks.pkl 的可读导出，由 python -m scripts.export_chunks 生成；
# 体积随语料增长且随时可重建，只作人工查看用，不进版本库。
data/chunks_latest.*

# 记忆：memory.md 是长期记忆，sessions/ 下是完整的对话记录，
# 这是本项目产出的最敏感的内容，不要提交。
data/memory/

# 原始文档和模型权重体积大且各环境不同，按需自行管理
# models/ 必须带前导斜杠：不带时该模式会匹配任意层级的同名目录，把 src/models/ 源码一并忽略。
data/gov_doc/
/models/

# MinerU 的版面/OCR/表格模型，由 python -m scripts.download_models --models mineru 下载，
# 体积约 1.6G，不进版本库。
data/mineru_home/

# 分块对比评测的大体积产物：每个策略一份临时向量库和全量分块导出，重跑评测即可重建。
# chunk_compare（切分策略）与 overlap_compare（重叠长度）结构同构，共用同一套规则。
# 结论类文件（manifest/metrics/stats/summary/report.md）此前入库，现已随产物一并清理。
tests/results/*compare/*/milvus.db/
tests/results/*compare/*/chunks.json
tests/results/*compare/*/chunks.pkl

# 重跑评测前的旧报告备份：只是同一份数据换判分模型前后的对照，可随时重跑再生成。
# 当前结论性报告（rag_eval_report.json、retrieval_eval_report.json）正常入库。
tests/results/*.bak.json

# Python 运行缓存与构建产物
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# cnki_crawler 运行时数据（抓取的题录库与原始页面）
cnki_crawler/data/
energy_docs/data/
patent_corpus/data/

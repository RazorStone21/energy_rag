# 运行数据不属于源码：索引、片段缓存、模型权重和原始文档都由使用方自己准备。

# 索引与缓存，由 python main.py build 生成
data/chunks.pkl
data/build_manifest.json
data/build_manifest.pending
data/milvus.db/

# chunks.pkl 的可读导出，由 python -m scripts.export_chunks 生成；
# 体积随语料增长且随时可重建，只作人工查看用，不进版本库。
data/chunks_latest.*

# 记忆：memory.md 是长期记忆，sessions/ 下是完整的对话记录，
# 这是本项目产出的最敏感的内容，不要提交。
data/memory/

# 原始文档和模型权重体积大且各环境不同，按需自行管理
data/gov_doc/
models/

# 分块对比评测的中间产物：每个策略一份临时向量库和全量分块导出，重跑评测即可重建。
# chunk_compare（切分策略）与 overlap_compare（重叠长度）结构同构，共用同一套规则。
# 同目录下的 manifest.json、metrics.json、stats.json、summary.json、report.md 是评测结论，需要提交。
tests/results/*compare/*/milvus.db/
tests/results/*compare/*/chunks.json
tests/results/*compare/*/chunks.pkl

# Python 运行缓存与构建产物
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/
